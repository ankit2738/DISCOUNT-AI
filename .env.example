# Copy to .env for Docker Compose. Never commit the real .env file.
# Local non-Docker backend defaults to sqlite:///./discount_ai.db and can run without this file.

# --- Core ---
ENVIRONMENT=docker
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
DEMO_MODE=true
SEED_DEMO_DATA=true
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=discount_ai
POSTGRES_USER=discount
POSTGRES_PASSWORD=discount_ai_dev
# Local backend example:
# DATABASE_URL=postgresql+psycopg://discount:discount_ai_dev@localhost:5432/discount_ai

# --- Optional workers ---
REDIS_URL=redis://redis:6379/0

# --- Optional AI provider (fallback is used when blank) ---
AI_PROVIDER=fallback
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Optional notifications ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email / payments ---
EMAIL_PROVIDER=console
SMTP_URL=
PAYMENT_PROVIDER=sandbox

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
